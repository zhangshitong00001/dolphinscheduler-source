<%- aslTs %>
import { reactive, ref } from 'vue'
import { useI18n } from 'vue-i18n'
import {
  query<%= naming.pascal %>,
  create<%= naming.pascal %> as create<%= naming.pascal %>Api,
  update<%= naming.pascal %> as update<%= naming.pascal %>Api,
} from '@/service/modules/<%= naming.kebab %>'

export function useDetail() {
  const { t } = useI18n()

  const state = reactive({
    loading: ref(false),
    <%= naming.camel %>Form: ref({
<% fields.filter(f => f.required).forEach(function(field, index) { -%>
      <%= field.name %>: ''<%= index < fields.filter(f => f.required).length - 1 ? ',' : '' %>
<% }); -%>
    }),
  })

  async function getDetail(id: number) {
    state.loading = true
    try {
      const result = await query<%= naming.pascal %>(id)
      if (result) {
<% fields.filter(f => f.required).forEach(function(field) { -%>
        state.<%= naming.camel %>Form.<%= field.name %> = result.<%= field.name %> || ''
<% }); -%>
      }
    } catch (error) {
      console.error('Failed to fetch <%= naming.kebab %> detail:', error)
    } finally {
      state.loading = false
    }
  }

  async function create<%= naming.pascal %>() {
    state.loading = true
    try {
      await create<%= naming.pascal %>Api({
<% fields.filter(f => f.required).forEach(function(field, index) { -%>
        <%= field.name %>: state.<%= naming.camel %>Form.<%= field.name %><%= index < fields.filter(f => f.required).length - 1 ? ',' : '' %>
<% }); -%>
      })
    } catch (error) {
      console.error('Failed to create <%= naming.kebab %>:', error)
    } finally {
      state.loading = false
    }
  }

  async function update<%= naming.pascal %>(id: number) {
    state.loading = true
    try {
      await update<%= naming.pascal %>Api(id, {
<% fields.filter(f => f.required).forEach(function(field, index) { -%>
        <%= field.name %>: state.<%= naming.camel %>Form.<%= field.name %><%= index < fields.filter(f => f.required).length - 1 ? ',' : '' %>
<% }); -%>
      })
    } catch (error) {
      console.error('Failed to update <%= naming.kebab %>:', error)
    } finally {
      state.loading = false
    }
  }

  return { state, create<%= naming.pascal %>, update<%= naming.pascal %>, getDetail }
}

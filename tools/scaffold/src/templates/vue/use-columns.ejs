<%- aslTs %>
import { h, ref, reactive } from 'vue'
import { useI18n } from 'vue-i18n'
import { NButton, NSpace, NPopconfirm } from 'naive-ui'
import type { TableColumns } from './types'

export function useColumns(onEdit: (id: number) => void) {
  const { t } = useI18n()

  const columns = ref<TableColumns>([
    {
      title: '#',
      key: 'index',
      width: 60,
      render: (_row: any, index: number) => index + 1,
    },
<% fields.forEach(function(field, index) { -%>
    {
      title: t('<%= localePrefix %>.<%= field.name %>'),
      key: '<%= field.name %>',
      width: 160,
    },
<% }); -%>
    {
      title: t('resource.function_manage.create_time'),
      key: 'createTime',
      width: 180,
    },
    {
      title: t('resource.function_manage.update_time'),
      key: 'updateTime',
      width: 180,
    },
    {
      title: t('resource.function_manage.operation'),
      key: 'operation',
      width: 160,
      render: (row: any) =>
        h(NSpace, null, {
          default: () => [
            h(
              NButton,
              {
                size: 'tiny',
                type: 'primary',
                onClick: () => onEdit(row.id),
              },
              { default: () => t('resource.function_manage.edit') }
            ),
          ],
        }),
    },
  ])

  return { columns }
}

{
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(pnpm *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(cd dolphinscheduler-ui && *)",
      "Bash(git:*)",
      "Bash(java --version)",
      "Bash(javac --version)",
      "Bash(node --version)",
      "Bash(python3 --version)",
      "Bash(which *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(chmod *)",
      "Bash(echo *)",
      "Edit(**/*)",
      "Write(**/*)",
      "Read(**/*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(kubectl *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo '📝 Commit format: type: description | Types: feat, fix, refactor, test, docs, chore'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-java-conventions.sh \"${CLAUDE_TOOL_INPUT_FILE_PATH}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-summary.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "JAVA_HOME": "/usr/lib/jvm/jdk8u452-b09",
    "MAVEN_OPTS": "-Xmx2g -XX:MaxMetaspaceSize=512m"
  }
}
